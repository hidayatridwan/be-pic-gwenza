// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_SYSTEM
  PPIC
  RECEIPT
  FD
  MD
  INBOUND_OPERATOR
  OUTBOUND_OPERATOR
  PRODUCT_ADMIN
}

model User {
  user_id    Int      @id @default(autoincrement()) @db.Int
  username   String   @unique @db.VarChar(20)
  password   String   @db.VarChar(200)
  token      String?  @db.VarChar(500)
  user_agent String?  @db.VarChar(200)
  ip_address String?  @db.VarChar(100)
  full_name  String   @db.VarChar(100)
  role       Role     @default(PPIC)
  created_at DateTime @default(now())

  Inbound              Inbound[]
  ProjectItem          ProjectItem[]
  Project              Project[]
  TailorCreated        Tailor[]              @relation("TailorCreatedBy")
  TailorUpdated        Tailor[]              @relation("TailorUpdatedBy")
  ProductCreated       Product[]             @relation("ProductCreatedBy")
  ProductUpdated       Product[]             @relation("ProductUpdatedBy")
  FashionDesignCreated FashionDesign[]       @relation("FashionDesignCreatedBy")
  FashionDesignUpdated FashionDesign[]       @relation("FashionDesignUpdatedBy")
  MerchandiseCreated   Merchandise[]         @relation("MerchandiseCreatedBy")
  MerchandiseUpdated   Merchandise[]         @relation("MerchandiseUpdatedBy")
  SupplierCreated      Supplier[]            @relation("SupplierCreatedBy")
  SupplierUpdated      Supplier[]            @relation("SupplierUpdatedBy")
  ColorCreated         Color[]               @relation("ColorCreatedBy")
  ColorUpdated         Color[]               @relation("ColorUpdatedBy")
  Order                Order[]
  Outbound             Outbound[]
  MerchandiseInbound   MerchandiseInbound[]
  MerchandiseOutbound  MerchandiseOutbound[]
  Return               Return[]
  Import               Import[]

  @@map("users")
}

model Tailor {
  tailor_id   Int      @id @default(autoincrement()) @db.Int
  tailor_name String   @unique @db.VarChar(100)
  created_at  DateTime @default(now())
  created_by  Int?     @db.Int
  updated_at  DateTime @default(now())
  updated_by  Int?     @db.Int

  CreatedBy User? @relation("TailorCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User? @relation("TailorUpdatedBy", fields: [updated_by], references: [user_id])

  Inbound             Inbound[]
  ProjectItem         ProjectItem[]
  FashionDesign       FashionDesign[]
  MerchandiseOutbound MerchandiseOutbound[]

  @@map("tailors")
}

model Variant {
  variant_id   Int      @id @default(autoincrement()) @db.Int
  variant_name String   @unique @db.VarChar(100)
  created_at   DateTime @default(now())

  Inbound        Inbound[]
  ProjectItem    ProjectItem[]
  Order          Order[]
  Outbound       Outbound[]
  ProductVariant ProductVariant[]
  Return         Return[]

  @@map("variants")
}

model Product {
  product_id         Int      @id @default(autoincrement()) @db.Int
  fashiondesign_code String?  @db.VarChar(10)
  product_name       String   @unique @db.VarChar(255)
  cogs               Int?     @db.Int
  selling_price      Int?     @db.Int
  created_at         DateTime @default(now())
  created_by         Int?     @db.Int
  updated_at         DateTime @default(now())
  updated_by         Int?     @db.Int

  CreatedBy User? @relation("ProductCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User? @relation("ProductUpdatedBy", fields: [updated_by], references: [user_id])

  Inbound             Inbound[]
  ProjectItem         ProjectItem[]
  Order               Order[]
  MerchandiseOutbound MerchandiseOutbound[]
  Outbound            Outbound[]
  ProductVariant      ProductVariant[]
  Return              Return[]

  @@map("products")
}

model ProductVariant {
  product_variant_id Int @id @default(autoincrement()) @db.Int
  product_id         Int @db.Int
  variant_id         Int @db.Int

  Product Product? @relation(fields: [product_id], references: [product_id])
  Variant Variant? @relation(fields: [variant_id], references: [variant_id])

  @@unique([product_id, variant_id])
  @@map("productvariants")
}

enum ImportType {
  ORDER
  CANCEL
}

model Import {
  import_id    Int         @id @default(autoincrement()) @db.Int
  import_type  ImportType? @default(ORDER)
  file_name    String      @unique @db.VarChar(100)
  is_processed Boolean     @default(false)
  created_at   DateTime    @default(now())
  created_by   Int?        @db.Int

  User User? @relation(fields: [created_by], references: [user_id])

  @@map("imports")
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCEL
}

model Order {
  order_id       Int         @id @default(autoincrement()) @db.Int
  channel        String      @db.VarChar(100)
  order_number   String      @db.VarChar(100)
  status         OrderStatus @default(OPEN)
  product_id     Int?        @db.Int
  product_name   String      @db.VarChar(255)
  variant_id     Int?        @db.Int
  variant_name   String      @db.VarChar(100)
  quantity       Int         @db.Int
  start_date     DateTime?
  end_date       DateTime?
  delivery_date  DateTime?
  waybill_number String?     @db.VarChar(100)
  project_id     Int?        @db.Int
  created_at     DateTime    @default(now())
  created_by     Int?        @db.Int

  Product Product? @relation(fields: [product_id], references: [product_id])
  Variant Variant? @relation(fields: [variant_id], references: [variant_id])
  Project Project? @relation(fields: [project_id], references: [project_id])
  User    User?    @relation(fields: [created_by], references: [user_id])

  @@unique([channel, order_number, product_name, variant_name])
  @@index([start_date, end_date, delivery_date, status])
  @@map("orders")
}

enum ProjectStatus {
  OPEN
  PARTIAL
  FULFILLED
  CANCEL
}

model Project {
  project_id Int           @id @default(autoincrement()) @db.Int
  batch_id   String        @db.Char(6)
  pic_id     Int           @db.Int
  status     ProjectStatus @default(OPEN)
  created_at DateTime      @default(now())
  created_by Int?          @db.Int

  ProjectItem ProjectItem[]

  User  User?   @relation(fields: [pic_id], references: [user_id])
  Order Order[]

  @@map("projects")
}

model ProjectItem {
  projectitem_id Int           @id @default(autoincrement()) @db.Int
  project_id     Int           @db.Int
  pic_id         Int           @db.Int
  tailor_id      Int           @db.Int
  assign_date    DateTime      @db.Date()
  product_id     Int           @db.Int
  variant_id     Int           @db.Int
  quantity       Int           @db.Int
  status         ProjectStatus @default(OPEN)
  created_at     DateTime      @default(now())
  created_by     Int?          @db.Int

  Project Project?  @relation(fields: [project_id], references: [project_id])
  User    User?     @relation(fields: [pic_id], references: [user_id])
  Tailor  Tailor?   @relation(fields: [tailor_id], references: [tailor_id])
  Product Product?  @relation(fields: [product_id], references: [product_id])
  Variant Variant?  @relation(fields: [variant_id], references: [variant_id])
  Inbound Inbound[]

  @@map("projectitems")
}

enum InboundStatus {
  OK
  CANCEL
}

model Inbound {
  inbound_id     Int           @id @default(autoincrement()) @db.Int
  inbound_date   DateTime      @db.Date()
  projectitem_id Int           @db.Int
  pic_id         Int           @db.Int
  tailor_id      Int           @db.Int
  product_id     Int           @db.Int
  variant_id     Int           @db.Int
  quantity       Int           @db.Int
  notes          String?       @db.VarChar(255)
  status         InboundStatus @default(OK)
  created_at     DateTime      @default(now())
  created_by     Int?          @db.Int

  ProjectItem ProjectItem? @relation(fields: [projectitem_id], references: [projectitem_id])
  User        User?        @relation(fields: [pic_id], references: [user_id])
  Tailor      Tailor?      @relation(fields: [tailor_id], references: [tailor_id])
  Product     Product?     @relation(fields: [product_id], references: [product_id])
  Variant     Variant?     @relation(fields: [variant_id], references: [variant_id])

  @@map("inbounds")
}

enum ReturnStatus {
  OK
  CANCEL
}

model Return {
  return_id   Int          @id @default(autoincrement()) @db.Int
  return_date DateTime     @db.Date()
  product_id  Int          @db.Int
  variant_id  Int          @db.Int
  quantity    Int          @db.Int
  notes       String?      @db.VarChar(255)
  status      ReturnStatus @default(OK)
  created_at  DateTime     @default(now())
  created_by  Int?         @db.Int

  Product Product? @relation(fields: [product_id], references: [product_id])
  Variant Variant? @relation(fields: [variant_id], references: [variant_id])
  User    User?    @relation(fields: [created_by], references: [user_id])

  @@map("returns")
}

enum OutboundStatus {
  OK
  CANCEL
}

model Outbound {
  outbound_id   Int            @id @default(autoincrement()) @db.Int
  outbound_date DateTime       @db.Date()
  product_id    Int            @db.Int
  variant_id    Int            @db.Int
  quantity      Int            @db.Int
  notes         String?        @db.VarChar(255)
  status        OutboundStatus @default(OK)
  created_at    DateTime       @default(now())
  created_by    Int?           @db.Int

  Product Product? @relation(fields: [product_id], references: [product_id])
  Variant Variant? @relation(fields: [variant_id], references: [variant_id])
  User    User?    @relation(fields: [created_by], references: [user_id])

  @@map("outbounds")
}

model FashionDesign {
  fashiondesign_id    Int                   @id @default(autoincrement()) @db.Int
  sample_code         String                @db.VarChar(10)
  sample_file         String?               @db.VarChar(255)
  tailor_id           Int?                  @db.Int
  send_sample_date    DateTime?             @db.Date()
  receive_sample_date DateTime?             @db.Date()
  revision_date       DateTime?             @db.Date()
  revision_file       String?               @db.VarChar(255)
  on_production_date  DateTime?             @db.Date()
  fix_sample_date     DateTime?             @db.Date()
  obstacle            String?               @db.VarChar(255)
  created_at          DateTime              @default(now())
  created_by          Int?                  @db.Int
  updated_at          DateTime              @default(now())
  updated_by          Int?                  @db.Int
  MerchandiseOutbound MerchandiseOutbound[]

  Tailor    Tailor? @relation(fields: [tailor_id], references: [tailor_id])
  CreatedBy User?   @relation("FashionDesignCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User?   @relation("FashionDesignUpdatedBy", fields: [updated_by], references: [user_id])

  @@map("fashiondesigns")
}

enum Category {
  MATERIAL
  ACCESORIES
}

model Merchandise {
  merchandise_id Int      @id @default(autoincrement()) @db.Int
  product_name   String   @unique @db.VarChar(255)
  category       Category @default(MATERIAL)
  image          String?  @db.VarChar(255)
  created_at     DateTime @default(now())
  created_by     Int?     @db.Int
  updated_at     DateTime @default(now())
  updated_by     Int?     @db.Int

  CreatedBy User? @relation("MerchandiseCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User? @relation("MerchandiseUpdatedBy", fields: [updated_by], references: [user_id])

  MerchandiseInbound  MerchandiseInbound[]
  MerchandiseOutbound MerchandiseOutbound[]

  @@map("merchandises")
}

model Supplier {
  supplier_id   Int      @id @default(autoincrement()) @db.Int
  supplier_name String   @unique @db.VarChar(100)
  created_at    DateTime @default(now())
  created_by    Int?     @db.Int
  updated_at    DateTime @default(now())
  updated_by    Int?     @db.Int

  CreatedBy User? @relation("SupplierCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User? @relation("SupplierUpdatedBy", fields: [updated_by], references: [user_id])

  MerchandiseInbound MerchandiseInbound[]

  @@map("suppliers")
}

model Color {
  color_id   Int      @id @default(autoincrement()) @db.Int
  color_name String   @unique @db.VarChar(100)
  created_at DateTime @default(now())
  created_by Int?     @db.Int
  updated_at DateTime @default(now())
  updated_by Int?     @db.Int

  CreatedBy User? @relation("ColorCreatedBy", fields: [created_by], references: [user_id])
  UpdatedBy User? @relation("ColorUpdatedBy", fields: [updated_by], references: [user_id])

  MerchandiseInbound MerchandiseInbound[]

  @@map("colors")
}

enum MerchandiseInboundStatus {
  OPEN
  CANCEL
  CLOSED
}

model MerchandiseInbound {
  merchandise_inbound_id Int                      @id @default(autoincrement()) @db.Int
  inbound_date           DateTime                 @db.Date()
  inbound_code           String                   @db.VarChar(100)
  merchandise_id         Int                      @db.Int
  supplier_id            Int                      @db.Int
  color_id               Int                      @db.Int
  price                  Int                      @db.Int
  quantity               Int                      @db.Int
  notes                  String?                  @db.VarChar(255)
  status                 MerchandiseInboundStatus @default(OPEN)
  created_at             DateTime                 @default(now())
  created_by             Int?                     @db.Int

  Merchandise Merchandise? @relation(fields: [merchandise_id], references: [merchandise_id])
  Supplier    Supplier?    @relation(fields: [supplier_id], references: [supplier_id])
  Color       Color?       @relation(fields: [color_id], references: [color_id])
  User        User?        @relation(fields: [created_by], references: [user_id])

  @@map("merchandiseinbounds")
}

enum MerchandiseOutboundStatus {
  OK
  CANCEL
}

model MerchandiseOutbound {
  merchandise_outbound_id Int                       @id @default(autoincrement()) @db.Int
  outbound_date           DateTime                  @db.Date()
  outbound_code           String                    @db.VarChar(100)
  merchandise_id          Int                       @db.Int
  supplier_id             Int                       @db.Int
  color_id                Int                       @db.Int
  fashiondesign_id        Int?                      @db.Int
  product_id              Int?                      @db.Int
  tailor_id               Int                       @db.Int
  quantity                Int                       @db.Int
  notes                   String?                   @db.VarChar(255)
  status                  MerchandiseOutboundStatus @default(OK)
  created_at              DateTime                  @default(now())
  created_by              Int?                      @db.Int

  Merchandise   Merchandise?   @relation(fields: [merchandise_id], references: [merchandise_id])
  FashionDesign FashionDesign? @relation(fields: [fashiondesign_id], references: [fashiondesign_id])
  Product       Product?       @relation(fields: [product_id], references: [product_id])
  Tailor        Tailor?        @relation(fields: [tailor_id], references: [tailor_id])
  User          User?          @relation(fields: [created_by], references: [user_id])

  @@index([outbound_code])
  @@map("merchandiseoutbounds")
}
